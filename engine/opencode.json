{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Volcano Ark",
      "options": {
        "baseURL": "https://ark.cn-beijing.volces.com/api/v3",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "doubao-seed-2-1-lite-260915": {
          "name": "Doubao Seed 2.1 Lite"
        }
      }
    }
  },
  "model": "ark/doubao-seed-2-1-lite-260915",
  "mcp": {
    "cashflow": {
      "type": "local",
      "command": [
        "python3",
        "mcp/cashflow_mcp.py"
      ],
      "enabled": true
    },
    "receipt": {
      "type": "local",
      "command": [
        "python3",
        "mcp/receipt_mcp.py"
      ],
      "enabled": true
    },
    "bill": {
      "type": "local",
      "command": [
        "python3",
        "mcp/bill_import_mcp.py"
      ],
      "enabled": true
    }
  }
}
